# Bridgenote Backend 환경변수 예시.
# 이 파일을 .env 로 복사 후 실제 값을 채우세요. (.env 는 커밋 금지)
# 값은 환경변수/실행 구성으로 주입되며, application-dev.yml 이 ${...} 로 참조합니다.
# (또는 application-dev.yml 에 직접 값을 넣어도 됩니다 — 해당 파일도 gitignore 대상)

# --- Supabase (PostgreSQL) ---
SUPABASE_DB_URL=jdbc:postgresql://<PROJECT>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- AI 서버 (realtime → 내부 HTTP 호출) ---
AI_SERVER_URL=http://localhost:8000
