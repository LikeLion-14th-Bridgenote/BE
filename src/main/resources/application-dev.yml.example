# application-dev.yml 템플릿 (커밋 대상).
# 이 파일을 application-dev.yml 로 복사한 뒤 실제 Supabase 값을 채우세요.
#   cp application-dev.yml.example application-dev.yml
# application-dev.yml 자체는 .gitignore 처리되어 커밋되지 않습니다.
spring:
  datasource:
    url: ${SUPABASE_DB_URL:jdbc:postgresql://<PROJECT>.supabase.co:5432/postgres}
    username: ${SUPABASE_DB_USER:postgres}
    password: ${SUPABASE_DB_PASSWORD:}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
  sql:
    init:
      mode: never

# Supabase Auth (로그인/회원가입 = SupabaseAuthClient). 값은 Supabase 대시보드 → Project Settings → API.
# ⚠️ 이 섹션이 비면 로그인이 localhost:80으로 붙어 500이 난다. 반드시 채울 것.
supabase:
  url: ${SUPABASE_URL:https://<PROJECT>.supabase.co}      # Project URL
  publishable-key: ${SUPABASE_PUBLISHABLE_KEY:}           # anon / publishable key (sb_publishable_...)
  secret-key: ${SUPABASE_SECRET_KEY:}                     # service_role / secret key (sb_secret_...)

# AI 서버(bridgenote-AI) 주소. 배포 시 같은 서버 내부 호출이면 localhost 유지.
bridgenote:
  ai:
    server-url: ${AI_SERVER_URL:http://localhost:8000}

# Deepgram STT (실시간). 값은 Deepgram 대시보드.
deepgram:
  api-key: ${DEEPGRAM_API_KEY:}
